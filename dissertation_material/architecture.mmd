graph TD
    subgraph "Ingestion Layer"
        Xero[Xero API] --> OAuth[OAuth2 Manager]
        OAuth --> Fetcher[Data Fetcher]
    end

    subgraph "Core Processing (Decimal Mandate)"
        Fetcher --> Parser[Xero API Parser]
        Parser --> Masker[Data Masker / Anonymizer]
        Masker --> Rules[Deterministic Rules Engine]
        Rules --> Variance[Variance & Materiality Analyzer]
    end

    subgraph "Agentic Synthesis (CrewAI)"
        Variance --> Analyst[Senior Financial Analyst Agent]
        Analyst --> Writer[Accounting Partner Agent]
        Writer --> Reviewer[QC Reviewer Agent]
        Reviewer -- "Reconciliation Error" --> Writer
    end

    subgraph "Presentation Layer (Flask)"
        Reviewer --> Dashboard[Accountant Workbench]
        Dashboard --> Review[Side-by-Side Review Panel]
    end
